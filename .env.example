# ============================================================
#  Arte'Sano — Variables de entorno.
#  Copia este archivo a ".env" y complétalo para desarrollo local.
#  En Render, carga estas mismas variables en Settings -> Environment.
# ============================================================

# Puerto. En local puedes usar 3000; en Render se inyecta automaticamente.
PORT=3000

# URL publica del servicio (retornos de pago, webhooks, enlaces en correos).
# Produccion: https://artesanoboutique.com  (dominio en Hostinger -> CNAME a Render)
PUBLIC_URL=http://localhost:3000

# --- Tienda ---
TIENDA_NOMBRE=Arte'Sano
TIENDA_NIT=
TIENDA_DIRECCION=Sincelejo, Sucre, Colombia
# Numero de WhatsApp de la tienda (solo digitos, con indicativo) para los botones "Pedir por WhatsApp".
TIENDA_WHATSAPP=57XXXXXXXXXX
# IVA por defecto para productos nuevos: iva_19 | iva_5 | exento | excluido
IVA_POR_DEFECTO=iva_19
# Tasa de cambio COP por USD para precios internacionales (si el producto no fija precio USD).
COP_POR_USD=4200
# Umbral (COP) para envio gratis en Colombia. 0 = nunca.
ENVIO_GRATIS_DESDE=150000

# --- Base de datos PostgreSQL (Render / Neon / Supabase) ---
# Si no se define, la tienda funciona EN MEMORIA con datos de ejemplo (se borran al reiniciar).
DATABASE_URL=

# --- Panel administrativo (/admin) ---
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_SESSION_SECRET=
# 2FA opcional (secreto base32 de Google Authenticator).
ADMIN_TOTP_SECRET=

# --- Imagenes de producto (Cloudinary) ---
# Si no se configura, en el panel se pueden pegar URLs de imagen directamente.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CARPETA=artesano

# --- Pagos RAPYD ---
RAPYD_ACCESS_KEY=
RAPYD_SECRET_KEY=
# Sandbox por defecto. Produccion: https://api.rapyd.net
RAPYD_BASE_URL=https://sandboxapi.rapyd.net
RAPYD_PAIS=CO

# --- Correos (Resend) ---
RESEND_API_KEY=
CORREO_REMITENTE=Arte'Sano <pedidos@artesanoboutique.com>
CORREO_TIENDA=pedidos@artesanoboutique.com
CORREO_RESPONDER=pedidos@artesanoboutique.com
# Correo de contacto general mostrado al público (pie de página, políticas, privacidad).
CORREO_CONTACTO=contacto@artesanoboutique.com

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=artesano-verificacion-2026
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# --- IA del chatbot (Claude) — se activa en la Fase 3 ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-sonnet-5
